generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model ProxyLog {
  id                    Int      @id @default(autoincrement())
  timestamp             DateTime @default(now())
  model                 String
  inputTokens           Int      @map("input_tokens")
  outputTokens          Int      @map("output_tokens")
  cacheReadTokens       Int      @default(0) @map("cache_read_tokens")
  cacheCreationTokens   Int      @default(0) @map("cache_creation_tokens")
  teamName              String?  @map("team_name")
  memberName            String?  @map("member_name")
  endpoint              String
  latencyMs             Int      @map("latency_ms")
  statusCode            Int      @map("status_code")

  @@map("proxy_logs")
}

model AnalyticsSnapshot {
  id            Int    @id @default(autoincrement())
  date          String
  model         String
  totalInput    Int    @map("total_input")
  totalOutput   Int    @map("total_output")
  estimatedCost Float  @map("estimated_cost")

  @@map("analytics_snapshots")
}

model IndexedProject {
  id          Int      @id @default(autoincrement())
  path        String   @unique
  name        String
  lastScanned DateTime? @map("last_scanned")
  tags        String   @default("[]")

  @@map("indexed_projects")
}

model Preference {
  key   String @id @unique
  value String

  @@map("preferences")
}

model QueuedTask {
  id          Int       @id @default(autoincrement())
  goal        String
  projectPath String    @map("project_path")
  status      String    @default("pending")   // pending | running | completed | failed | cancelled
  teamName    String?   @map("team_name")
  priority    Int       @default(0)
  result      String?
  createdAt   DateTime  @default(now()) @map("created_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  @@map("queued_tasks")
}
