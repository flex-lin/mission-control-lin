generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model ProxyLog {
  id                    Int      @id @default(autoincrement())
  timestamp             DateTime @default(now())
  model                 String
  inputTokens           Int      @map("input_tokens")
  outputTokens          Int      @map("output_tokens")
  cacheReadTokens       Int      @default(0) @map("cache_read_tokens")
  cacheCreationTokens   Int      @default(0) @map("cache_creation_tokens")
  teamName              String?  @map("team_name")
  memberName            String?  @map("member_name")
  endpoint              String
  latencyMs             Int      @map("latency_ms")
  statusCode            Int      @map("status_code")

  @@map("proxy_logs")
}

model AnalyticsSnapshot {
  id            Int    @id @default(autoincrement())
  date          String
  model         String
  totalInput    Int    @map("total_input")
  totalOutput   Int    @map("total_output")
  estimatedCost Float  @map("estimated_cost")

  @@map("analytics_snapshots")
}

model IndexedProject {
  id          Int      @id @default(autoincrement())
  path        String   @unique
  name        String
  lastScanned DateTime? @map("last_scanned")
  tags        String   @default("[]")

  @@map("indexed_projects")
}

model Preference {
  key   String @id @unique
  value String

  @@map("preferences")
}

model QueuedTask {
  id          Int       @id @default(autoincrement())
  goal        String
  projectPath String    @map("project_path")
  status      String    @default("pending")   // pending | running | completed | failed | cancelled
  teamName    String?   @map("team_name")
  priority    Int       @default(0)
  result      String?
  attachments String    @default("[]")         // JSON array of TaskAttachment objects
  teamMembers String    @default("[]")         @map("team_members") // JSON array of selected TeamMemberRole ids or inline role objects
  createdAt   DateTime  @default(now()) @map("created_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  @@index([status, createdAt])
  @@index([teamName])
  @@map("queued_tasks")
}

/// User-defined and preset roles available for team composition
model TeamMemberRole {
  id          Int      @id @default(autoincrement())
  name        String   @unique                // kebab-case agent name, e.g. "frontend-dev"
  role        String                          // display title, e.g. "Frontend Developer"
  agentType   String   @map("agent_type")    // "general-purpose" | "Bash" | "Explore" | "Plan"
  description String                          // what this role is responsible for
  isPreset    Boolean  @default(false) @map("is_preset")  // true = shipped with app; false = user-created
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("team_member_roles")
}

/// Record synced from Anthropic Usage API (per-bucket, per-model)
model UsageRecord {
  id                     Int      @id @default(autoincrement())
  bucketStart            DateTime @map("bucket_start")
  bucketEnd              DateTime @map("bucket_end")
  bucketWidth            String   @map("bucket_width")    // "1m" | "1h" | "1d"
  model                  String?
  workspaceId            String?  @map("workspace_id")
  serviceTier            String?  @map("service_tier")
  uncachedInputTokens    Int      @default(0) @map("uncached_input_tokens")
  cacheReadInputTokens   Int      @default(0) @map("cache_read_input_tokens")
  cache5mCreationTokens  Int      @default(0) @map("cache_5m_creation_tokens")
  cache1hCreationTokens  Int      @default(0) @map("cache_1h_creation_tokens")
  outputTokens           Int      @default(0) @map("output_tokens")
  webSearchRequests      Int      @default(0) @map("web_search_requests")
  syncedAt               DateTime @default(now()) @map("synced_at")

  @@unique([bucketStart, bucketWidth, model, workspaceId, serviceTier], name: "usage_bucket_unique")
  @@index([bucketStart])
  @@index([model])
  @@map("usage_records")
}

/// Record synced from Anthropic Cost API (daily, per-model, per-token-type)
model CostRecord {
  id              Int      @id @default(autoincrement())
  bucketStart     DateTime @map("bucket_start")
  bucketEnd       DateTime @map("bucket_end")
  model           String?
  workspaceId     String?  @map("workspace_id")
  serviceTier     String?  @map("service_tier")
  costType        String?  @map("cost_type")     // "tokens" | "web_search" | "code_execution"
  tokenType       String?  @map("token_type")    // "uncached_input_tokens" | "output_tokens" | etc.
  amountCents     Float    @map("amount_cents")  // cost in cents USD
  currency        String   @default("USD")
  syncedAt        DateTime @default(now()) @map("synced_at")

  @@unique([bucketStart, model, workspaceId, costType, tokenType], name: "cost_bucket_unique")
  @@index([bucketStart])
  @@map("cost_records")
}

/// Claude Code per-user daily analytics from the Admin API
model ClaudeCodeDailyMetric {
  id                       Int      @id @default(autoincrement())
  date                     DateTime
  actorType                String   @map("actor_type")     // "user_actor" | "api_actor"
  actorIdentifier          String   @map("actor_identifier") // email or api_key_name
  terminalType             String?  @map("terminal_type")
  numSessions              Int      @default(0) @map("num_sessions")
  linesAdded               Int      @default(0) @map("lines_added")
  linesRemoved             Int      @default(0) @map("lines_removed")
  commitsByClaudeCode      Int      @default(0) @map("commits_by_claude_code")
  pullRequestsByClaudeCode Int      @default(0) @map("pull_requests_by_claude_code")
  editToolAccepted         Int      @default(0) @map("edit_tool_accepted")
  editToolRejected         Int      @default(0) @map("edit_tool_rejected")
  writeToolAccepted        Int      @default(0) @map("write_tool_accepted")
  writeToolRejected        Int      @default(0) @map("write_tool_rejected")
  notebookEditAccepted     Int      @default(0) @map("notebook_edit_accepted")
  notebookEditRejected     Int      @default(0) @map("notebook_edit_rejected")
  // Model breakdown stored as JSON string: [{model, inputTokens, outputTokens, cacheRead, cacheCreation, costCents}]
  modelBreakdown           String   @default("[]") @map("model_breakdown")
  syncedAt                 DateTime @default(now()) @map("synced_at")

  @@unique([date, actorIdentifier], name: "cc_daily_unique")
  @@index([date])
  @@map("claude_code_daily_metrics")
}

/// Tracks sync state so we know what's already been fetched
model UsageSyncCursor {
  id         String   @id           // "usage" | "cost" | "claude_code"
  lastSyncAt DateTime @map("last_sync_at")  // last bucket end we synced up to
  updatedAt  DateTime @default(now()) @map("updated_at")

  @@map("usage_sync_cursors")
}

/// Checkpoint captured before sleep or periodically, used for auto-resume
model SessionCheckpoint {
  id          Int       @id @default(autoincrement())
  teamName    String    @map("team_name")
  checkpoint  String    // JSON-encoded SessionCheckpointData
  createdAt   DateTime  @default(now()) @map("created_at")
  resumedAt   DateTime? @map("resumed_at")

  @@index([teamName])
  @@map("session_checkpoints")
}

/// Tracks compilation errors that have been detected and queued for self-healing
model CompilationError {
  id              Int       @id @default(autoincrement())
  projectPath     String    @map("project_path")
  errorMessage    String    @map("error_message")    // full compiler error output
  errorType       String    @map("error_type")        // "typescript" | "build" | "lint" | "runtime"
  filePath        String?   @map("file_path")         // source file where error occurred (if parseable)
  lineNumber      Int?      @map("line_number")
  status          String    @default("pending")       // "pending" | "healing" | "healed" | "failed" | "skipped"
  healingStrategy String?   @map("healing_strategy")  // strategy chosen by AI: "fix_types" | "fix_imports" | "fix_syntax" | "custom"
  resolution      String?                             // human-readable description of what was fixed
  retryCount      Int       @default(0) @map("retry_count")
  maxRetries      Int       @default(3) @map("max_retries")
  createdAt       DateTime  @default(now()) @map("created_at")
  healedAt        DateTime? @map("healed_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  healingAttempts HealingAttempt[]

  @@index([projectPath, status])
  @@index([status, createdAt])
  @@map("compilation_errors")
}

/// Records each individual healing attempt for a CompilationError
model HealingAttempt {
  id               Int      @id @default(autoincrement())
  compilationError   CompilationError @relation(fields: [compilationErrorId], references: [id], onDelete: Cascade)
  compilationErrorId Int    @map("compilation_error_id")
  attemptNumber    Int      @map("attempt_number")
  strategy         String                               // healing strategy used
  patch            String?                              // JSON-encoded file patches applied
  buildOutput      String?  @map("build_output")        // compiler output after this attempt
  success          Boolean  @default(false)
  errorAfter       String?  @map("error_after")         // remaining errors if not fully healed
  durationMs       Int?     @map("duration_ms")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([compilationErrorId])
  @@map("healing_attempts")
}
